$TTL	604800
@	IN 			SOA servidor.chochua.local. admin.chochua.local. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
 
  IN NS  chochua.local.
@ IN A 192.168.1.5
chochua.local IN MX 10 correo.chochua.local.
servidor  IN A 192.168.1.5
ns  IN A  192.168.1.5
www  IN A  192.168.1.5
server  IN CNAME   chochua.local
pop3   IN  CNAME   servidor
smtp   IN  CNAME   servidor
